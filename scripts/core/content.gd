extends Node
## Loads the data-driven content (data/*.json, generated by tools/content/build_content.py)
## and provides indexes plus art lookups with graceful placeholders.

var DATA_DIR := "res://data/"
const ICON_DIR := "res://assets/icons/items/"
const BUILDING_DIR := "res://assets/buildings/"
const ENV_DIR := "res://assets/env/"

var items: Dictionary = {}
var item_list: Array = []
var recipes: Dictionary = {}
var recipe_list: Array = []
var buildings: Dictionary = {}
var building_list: Array = []
var techs: Dictionary = {}
var tech_list: Array = []
var world: Dictionary = {}
var deposits: Dictionary = {}
var sectors: Array = []
var sector_by_id: Dictionary = {}
var threats: Array = []
var contracts: Array = []
var achievements: Array = []
var megaprojects: Array = []
var start: Dictionary = {}

var recipes_by_category: Dictionary = {}
var recipes_by_output: Dictionary = {}
var recipes_by_input: Dictionary = {}
var buildings_by_category: Dictionary = {}
var tech_by_recipe: Dictionary = {}
var research_items: Array = []
var item_uses: Dictionary = {}   # item -> Array of strings describing uses (lazy)
var max_tier := 0

var _icon_cache: Dictionary = {}
var _sheet_cache: Dictionary = {}
var _tex_cache: Dictionary = {}
var loaded := false


func _ready() -> void:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--data="):
			DATA_DIR = a.substr(7)
	load_all()


func _read_json(name: String) -> Variant:
	var path := DATA_DIR + name + ".json"
	if not FileAccess.file_exists(path):
		push_warning("Content: missing " + path)
		return null
	var txt := FileAccess.get_file_as_string(path)
	var v = JSON.parse_string(txt)
	if v == null:
		push_error("Content: failed to parse " + path)
	return v


func load_all() -> void:
	items.clear(); recipes.clear(); buildings.clear(); techs.clear()
	var d = _read_json("items")
	item_list = d.get("items", []) if d else []
	for it in item_list:
		items[it.id] = it
		max_tier = maxi(max_tier, int(it.get("tier", 0)))
	d = _read_json("recipes")
	recipe_list = d.get("recipes", []) if d else []
	for r in recipe_list:
		recipes[r.id] = r
		recipes_by_category.get_or_add(r.category, []).append(r.id)
		for o in r.get("outputs", {}):
			recipes_by_output.get_or_add(o, []).append(r.id)
		for i in r.get("inputs", {}):
			recipes_by_input.get_or_add(i, []).append(r.id)
	d = _read_json("buildings")
	building_list = d.get("buildings", []) if d else []
	for b in building_list:
		buildings[b.id] = b
		for c in b.get("categories", []):
			buildings_by_category.get_or_add(c, []).append(b.id)
	d = _read_json("techs")
	tech_list = d.get("techs", []) if d else []
	var ri := {}
	for t in tech_list:
		techs[t.id] = t
		for r in t.get("unlocks", []):
			tech_by_recipe[r] = t.id
		for c in t.get("cost", {}):
			ri[c] = true
	research_items = ri.keys()
	research_items.sort_custom(func(a, b): return int(items.get(a, {}).get("tier", 0)) < int(items.get(b, {}).get("tier", 0)))
	d = _read_json("world")
	world = d if d else {}
	deposits.clear()
	for dep in world.get("deposits", []):
		deposits[dep.id] = dep
	sectors = world.get("sectors", [])
	sector_by_id.clear()
	for s in sectors:
		sector_by_id[s.id] = s
	threats = world.get("threats", [])
	contracts = world.get("contracts", [])
	achievements = world.get("achievements", [])
	megaprojects = world.get("megaprojects", [])
	start = world.get("start", {})
	loaded = true
	print("Content: %d items, %d recipes, %d buildings, %d techs, %d sectors" % [items.size(), recipes.size(), buildings.size(), techs.size(), sectors.size()])


# ------------------------------------------------------------------ queries
func item_name(id: String) -> String:
	return items.get(id, {}).get("name", id.capitalize())


func is_fluid(id: String) -> bool:
	return items.get(id, {}).get("kind", "solid") == "fluid"


func item_value(id: String) -> float:
	return float(items.get(id, {}).get("value", 1.0))


func buildings_for_recipe(rid: String) -> Array:
	var r: Dictionary = recipes.get(rid, {})
	return buildings_by_category.get(r.get("category", ""), [])


func recipes_for_building(bid: String) -> Array:
	var out: Array = []
	for c in buildings.get(bid, {}).get("categories", []):
		out.append_array(recipes_by_category.get(c, []))
	return out


func recipe_main_output(rid: String) -> String:
	var outs: Dictionary = recipes.get(rid, {}).get("outputs", {})
	if outs.is_empty():
		return ""
	if outs.has(rid):
		return rid
	var best := ""
	var bestv := -1.0
	for o in outs:
		var v := item_value(o) * float(outs[o])
		if v > bestv:
			bestv = v
			best = o
	return best


func is_extraction(rid: String) -> bool:
	return recipes.get(rid, {}).has("deposit")


# ------------------------------------------------------------------ art
func _load_texture(path: String) -> Texture2D:
	if _tex_cache.has(path):
		return _tex_cache[path]
	var tex: Texture2D = null
	if ResourceLoader.exists(path):
		tex = load(path)
	elif FileAccess.file_exists(path):
		var img := Image.load_from_file(ProjectSettings.globalize_path(path))
		if img:
			tex = ImageTexture.create_from_image(img)
	_tex_cache[path] = tex
	return tex


func icon(id: String) -> Texture2D:
	if _icon_cache.has(id):
		return _icon_cache[id]
	var tex := _load_texture(ICON_DIR + id + ".png")
	if tex == null:
		tex = _placeholder_icon(id)
	_icon_cache[id] = tex
	return tex


func _placeholder_icon(id: String) -> Texture2D:
	var size := 64
	var img := Image.create(size, size, false, Image.FORMAT_RGBA8)
	var it: Dictionary = items.get(id, {})
	var col := Color.from_hsv(float(hash(id) % 360) / 360.0, 0.55, 0.85)
	var vis: Dictionary = it.get("visual", {})
	if vis.has("color"):
		var c: Array = vis.color
		col = Color(c[0], c[1], c[2]).linear_to_srgb()
	var fluid = it.get("kind", "solid") == "fluid"
	for y in size:
		for x in size:
			var dx := (x - size / 2.0 + 0.5) / (size / 2.0)
			var dy := (y - size / 2.0 + 0.5) / (size / 2.0)
			var r := sqrt(dx * dx + dy * dy) if fluid else maxf(absf(dx), absf(dy))
			if r < 0.78:
				var shade := 1.0 - 0.35 * (dy + 1.0) * 0.5
				img.set_pixel(x, y, Color(col.r * shade, col.g * shade, col.b * shade, 1.0))
			elif r < 0.86:
				img.set_pixel(x, y, Color(0, 0, 0, 0.6))
	return ImageTexture.create_from_image(img)


## Returns {texture, meta} for a building sprite sheet, or {} if not rendered yet.
func building_sheet(bid: String) -> Dictionary:
	if _sheet_cache.has(bid):
		return _sheet_cache[bid]
	var out := {}
	var meta_path := BUILDING_DIR + bid + ".json"
	if FileAccess.file_exists(meta_path):
		var meta = JSON.parse_string(FileAccess.get_file_as_string(meta_path))
		var tex := _load_texture(BUILDING_DIR + bid + ".png")
		if meta and tex:
			out = {"texture": tex, "meta": meta}
	_sheet_cache[bid] = out
	return out


func env_texture(name: String) -> Texture2D:
	return _load_texture(ENV_DIR + name + ".png")


func deposit_sprite(dep_id: String) -> Dictionary:
	var key := "deposit_" + dep_id
	if _sheet_cache.has(key):
		return _sheet_cache[key]
	var out := {}
	var tex := _load_texture(ENV_DIR + key + ".png")
	if tex:
		var meta = {}
		if FileAccess.file_exists(ENV_DIR + key + ".json"):
			meta = JSON.parse_string(FileAccess.get_file_as_string(ENV_DIR + key + ".json"))
		out = {"texture": tex, "meta": meta if meta else {}}
	_sheet_cache[key] = out
	return out


func ui_texture(name: String) -> Texture2D:
	return _load_texture("res://assets/ui/" + name + ".png")
